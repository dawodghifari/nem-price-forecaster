# Copy to .env and adjust. .env is gitignored.

POSTGRES_USER=nemfc
POSTGRES_PASSWORD=nemfc
POSTGRES_DB=nemfc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Where downloaded NEMWeb archives and weather pulls land. Gitignored.
NEMFC_DATA_DIR=./data

# Region under study. NSW1 to start; VIC1/SA1/QLD1/TAS1 later.
NEMFC_REGION=NSW1

# Spike threshold in $/MWh. Sensitivity to this is part of the analysis.
NEMFC_SPIKE_THRESHOLD=300

# Polite identification when hitting AEMO. AEMO grants general permission to
# use its material with attribution, but a contactable UA is good manners and
# reduces the chance of being rate-limited.
NEMFC_USER_AGENT=nem-price-forecaster/0.1 (portfolio project; +https://github.com/)
